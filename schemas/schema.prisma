datasource db { provider = "postgresql" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }

enum Role { INVENTORY_MANAGER WAREHOUSE_STAFF }
enum DocType { RECEIPT DELIVERY INTERNAL ADJUSTMENT }
enum DocStatus { DRAFT WAITING READY DONE CANCELED }
enum MoveDirection { IN OUT INTERNAL }

model User {
  id String @id @default(uuid())
  loginId String @unique
  email String @unique
  passwordHash String
  name String
  role Role @default(WAREHOUSE_STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  operations Operation[] @relation("ResponsibleUser")
}
model Warehouse {
  id String @id @default(uuid())
  name String
  code String @unique
  address String
  locations Location[]
}
model Location {
  id String @id @default(uuid())
  name String
  warehouseId String
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  stockLevels StockLevel[]
  movesFrom StockMove[] @relation("SourceLocation")
  movesTo StockMove[] @relation("DestLocation")
  @@unique([warehouseId, name])
}
model Product {
  id String @id @default(uuid())
  name String
  sku String @unique
  category String
  uom String
  perUnitCost Decimal @db.Decimal(12, 2)
  lowStockAlert Int @default(10)
  stockLevels StockLevel[]
  operationLines OperationLine[]
  stockMoves StockMove[]
}
model StockLevel {
  id String @id @default(uuid())
  productId String
  locationId String
  onHand Int @default(0)
  reserved Int @default(0)
  product Product @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  @@unique([productId, locationId])
}
model Operation {
  id String @id @default(uuid())
  reference String @unique
  type DocType
  status DocStatus @default(DRAFT)
  contact String
  scheduledDate DateTime
  deliveryAddress String?
  responsibleId String
  responsible User @relation("ResponsibleUser", fields: [responsibleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines OperationLine[]
  stockMoves StockMove[]
  @@index([type, status, scheduledDate])
}
model OperationLine {
  id String @id @default(uuid())
  operationId String
  productId String
  quantity Int
  operation Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@unique([operationId, productId])
}
model StockMove {
  id String @id @default(uuid())
  reference String
  date DateTime @default(now())
  direction MoveDirection
  operationId String?
  productId String
  fromLocationId String?
  toLocationId String?
  quantity Int
  contact String
  operation Operation? @relation(fields: [operationId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  fromLocation Location? @relation("SourceLocation", fields: [fromLocationId], references: [id])
  toLocation Location? @relation("DestLocation", fields: [toLocationId], references: [id])
  @@index([productId, date])
  @@index([reference, date])
}
